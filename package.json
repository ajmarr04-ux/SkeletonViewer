{
  "name": "skeleton-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ids": "python3 scripts/mapping/generate_ids.py",
    "audit-soft": "python3 scripts/mapping/classify_soft_tissue.py",
    "soft-ids": "python3 scripts/mapping/generate_soft_ids.py",
    "check-models": "tsx scripts/check-models.ts",
    "build-models": "bash scripts/build-models.sh",
    "build-soft": "bash scripts/build-soft-tissue.sh",
    "compress-models": "bash scripts/compress-models.sh",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "check": "tsc --noEmit && vitest run && npm run check-models && SKV_REGISTRY=fixture npm run check-models && npm run regions:volumes -- --check && npm run regions:membership -- --check && npm run validate-content && npm run content:migrate-attachments -- --check",
    "build-pages": "bash scripts/build-pages.sh",
    "validate-content": "tsx scripts/validate-content.ts",
    "content:mirror": "tsx scripts/content/mirror.ts",
    "content:migrate-attachments": "tsx scripts/content/migrate-attachments.ts",
    "content:patch-check": "tsx scripts/content/patch-check.ts",
    "content:hierarchy": "tsx scripts/content/build-hierarchy.ts",
    "prebuild": "npm run validate-content && npm run content",
    "content": "tsx scripts/build-content.ts",
    "search-index": "tsx scripts/build-search-index.ts",
    "perf-load": "tsx scripts/perf-load.ts",
    "golden": "tsx scripts/golden.ts",
    "bench-container": "tsx scripts/bench-container.ts",
    "regions:volumes": "tsx scripts/regions/volumes.ts",
    "regions:membership": "tsx scripts/regions/membership.ts",
    "regions": "tsx scripts/regions/volumes.ts && tsx scripts/regions/membership.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "gltfpack": "^1.3.0",
    "meshoptimizer": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "camera-controls": "^3.1.2",
    "marked": "^18.2.1",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
